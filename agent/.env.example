# LLM Provider (OpenAI-compatible)
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://your-openai-compatible-endpoint.com/v1
MODEL_NAME=openai/gpt-4o

# Default location for weather tool. Accepts just a city name or "City,State,Country" format.
# Only the city portion is used for weather lookup. Examples: Austin or "Katy,Tx,US"
WEATHER_LOCATION=Austin

# Home Assistant WebSocket connection
# URL of your Home Assistant instance
HA_URL=http://homeassistant.local:8123
# Long-Lived Access Token (HA Profile → Security → Create Token)
# IMPORTANT: Must be a Long-Lived Access Token, NOT an OAuth token
HA_TOKEN=your-ha-long-lived-token-here

# Web Search (SearXNG instance URL)
SEARCH_API_URL=http://localhost:8080

# Web Fetch cache TTL in milliseconds (default: 600000 = 10 minutes)
WEB_FETCH_CACHE_TTL=600000

# Mastra Server
PORT=4111
