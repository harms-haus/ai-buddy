# ── Server ──
TTS_PORT=10201
TTS_HOST=127.0.0.1
LOG_LEVEL=WARNING

# ── Backend Selection ──
# Which TTS engine to use: kokoro | chatterbox | dia | chattts
TTS_BACKEND=kokoro

# Generic voice/speed (used by all backends, overrides per-backend defaults)
# TTS_VOICE=
# TTS_SPEED=1.0

# ── Kokoro Backend ──
KOKORO_VOICE=af_heart
KOKORO_SPEED=1.0
KOKORO_MODEL_PATH=kokoro-v1.0.onnx
KOKORO_VOICES_PATH=voices-v1.0.bin

# ── Chatterbox Backend ──
# Device: cuda or cpu (auto-detected if unset)
# CHATTERBOX_DEVICE=cuda
# Emotion intensity: 0.25-2.0+ (higher = more expressive, default 0.5)
# CHATTERBOX_EXAGGERATION=0.5
# CHATTERBOX_CFG_WEIGHT=0.0
# CHATTERBOX_TEMPERATURE=0.8
# Emotion tags in text: [laugh] [chuckle] [sigh] [gasp] [cough] [groan] [sniff] [shush] [clear throat]

# ── Dia Backend ──
# Device: cuda (GPU required, no CPU support currently)
# DIA_DEVICE=cuda
# DIA_MODEL=nari-labs/Dia-1.6B-0626
# Emotion tags in text: (laughs) (sighs) (gasps) (singing) (mumbles) (screams) (chuckle) (whistles) etc.

# ── ChatTTS Backend ──
# NOTE: ChatTTS is licensed AGPLv3+ / CC-BY-NC 4.0 (non-commercial use only)
# CHATTTS_TEMPERATURE=0.3
# Prosody control tokens: [laugh] [uv_break] [lbreak] [oral_0-9] [laugh_0-2] [break_0-7]
# CHATTTS_REFINE_PROMPT=[oral_2][laugh_0][break_4]
